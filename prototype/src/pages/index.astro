---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE, PROJECTS, PUBLICATIONS } from '../data/mock';
const recentPubs = PUBLICATIONS.slice(0, 4);
const featuredProjects = PROJECTS.filter(p => p.featured).slice(0, 3);
---
<BaseLayout title="Kazuki Toma" description={PROFILE.tagline}>

  <!-- ── HERO: Full-bleed Space Music Hall render ──────── -->
  <section id="hero" class="relative h-screen min-h-[600px] flex items-end overflow-hidden">
    <!-- Background image -->
    <div class="absolute inset-0">
      <img src="/images/spectacle4.png" alt="Space Music Hall"
           class="w-full h-full object-cover object-center" />
      <!-- Gradient overlay: dark at bottom for text legibility, subtle at top -->
      <div class="absolute inset-0"
           style="background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.75) 100%);"></div>
    </div>

    <!-- Hero content: anchored to bottom-left -->
    <div class="relative z-10 max-w-6xl mx-auto px-6 pb-16 w-full">
      <div class="max-w-2xl">
        <p class="text-white/60 text-sm font-mono tracking-widest uppercase mb-3">
          Ph.D. Student · Texas A&amp;M University · Aerospace Engineering
        </p>
        <h1 class="font-heading text-5xl md:text-7xl font-bold text-white mb-4 leading-none tracking-tight">
          Kazuki Toma
        </h1>
        <p class="text-lg md:text-xl text-white/80 mb-8 leading-relaxed max-w-lg">
          {PROFILE.tagline}
        </p>
        <!-- CTA + social row -->
        <div class="flex flex-wrap items-center gap-4">
          <a href="/cv" class="px-5 py-2.5 rounded-lg font-medium text-sm transition-all"
             style="background:var(--color-accent);color:white;">
            View CV
          </a>
          <a href="/research" class="px-5 py-2.5 rounded-lg font-medium text-sm border border-white/40 text-white transition-all hover:border-white/80">
            Research
          </a>
          <!-- Social icons inline -->
          <div class="flex items-center gap-3 ml-2">
            <a href="https://github.com/toma-kazuki" target="_blank"
               class="text-white/60 hover:text-white transition-colors text-sm">GitHub</a>
            <span class="text-white/30">·</span>
            <a href="https://www.linkedin.com/in/toma-kazuki/" target="_blank"
               class="text-white/60 hover:text-white transition-colors text-sm">LinkedIn</a>
            <span class="text-white/30">·</span>
            <a href="mailto:kazengtoma@tamu.edu"
               class="text-white/60 hover:text-white transition-colors text-sm">Email</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-6 right-8 text-white/40 text-xs font-mono hidden md:block">
      View of the Earth through the stage window — Space Music Hall render by Kazuki Toma & Shuto Takashita
    </div>
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-white/40">
      <span class="text-xs font-mono">scroll</span>
      <div class="w-px h-8 bg-white/30 animate-pulse"></div>
    </div>
  </section>

  <!-- ── ABOUT: profile left, bio right ───────────────── -->
  <section id="about" class="fade-section opacity-0 max-w-6xl mx-auto px-6 py-20 md:py-28">
    <div class="grid md:grid-cols-3 gap-12 md:gap-16 items-start">

      <!-- Left: profile photo + SNS -->
      <div class="flex flex-col items-center text-center gap-5">
        <img src="/images/toma.jpg" alt="Kazuki Toma"
             class="w-48 h-48 rounded-full object-cover border-4 shadow-lg"
             style="border-color:var(--color-surface);" />
        <div>
          <p class="font-heading font-bold text-xl">Kazuki Toma</p>
          <p class="text-sm mt-0.5" style="color:var(--color-text-muted);">藤間一輝</p>
          <p class="text-xs mt-2" style="color:var(--color-text-secondary);">
            Ph.D. Student · Aerospace Engineering<br/>Texas A&amp;M University
          </p>
        </div>
        <!-- SNS links -->
        <div class="flex flex-col gap-2 w-full">
          {[
            { href: "https://github.com/toma-kazuki", label: "GitHub" },
            { href: "https://www.linkedin.com/in/toma-kazuki/", label: "LinkedIn" },
            { href: "https://scholar.google.com/citations?user=YOUR_SCHOLAR_ID", label: "Google Scholar" },
            { href: "https://www.researchgate.net/profile/Kazuki-Toma", label: "ResearchGate" },
            { href: "mailto:kazengtoma@tamu.edu", label: "Email" },
          ].map(link => (
            <a href={link.href} target={link.href.startsWith('mailto') ? undefined : '_blank'}
               class="flex items-center justify-center gap-2 px-4 py-2 text-sm rounded-lg border transition-all hover:border-accent"
               style="border-color:var(--color-border);color:var(--color-text-secondary);">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Right: bio (spans 2 columns) -->
      <div class="md:col-span-2 space-y-5" style="color:var(--color-text-secondary);">
        <div>
          <p class="section-label mb-2">About</p>
          <h2 class="font-heading text-3xl font-bold mb-4" style="color:var(--color-text-primary);">
            Human System Integration Engineer
          </h2>
        </div>
        <p class="leading-relaxed">
          I am a Ph.D. student at <strong style="color:var(--color-text-primary);">Texas A&amp;M University</strong>,
          working in the SEAK Lab under Prof. Daniel Selva. My research focuses on autonomous
          anomaly resolution for space habitats — building physics-based digital twins
          that can diagnose failures without ground support during deep-space missions.
        </p>
        <p class="leading-relaxed">
          My path into Human-Systems Integration began with
          <a href="/research/space-music-hall" style="color:var(--color-accent);">Space Music Hall</a> —
          my bachelor's capstone project, where I first combined systems engineering
          with anthropometric design and ECLSS to create a cultural facility module for LEO.
          That question — <em>"what does human presence in space actually require?"</em> —
          continues to drive my research.
        </p>
        <p class="leading-relaxed">
          Previously, I worked as Structural Design Lead at ArkEdge Space and
          Thermal Operations Engineer at ISAS/JAXA, contributing to missions
          including EQUULEUS (NASA SLS, 2022), SPHERE EYE-1, and ONGLAISAT.
        </p>
        <div class="flex gap-4 pt-2 flex-wrap">
          <a href="/cv" class="px-5 py-2 text-sm font-medium rounded-lg transition-colors"
             style="background:var(--color-accent);color:white;">View CV</a>
          <a href="/timeline" class="px-5 py-2 text-sm font-medium rounded-lg border transition-colors"
             style="border-color:var(--color-border);color:var(--color-text-secondary);">Career Timeline →</a>
          <a href="/research" class="px-5 py-2 text-sm font-medium rounded-lg border transition-colors"
             style="border-color:var(--color-border);color:var(--color-text-secondary);">Research →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FEATURED RESEARCH ──────────────────────────────── -->
  <section class="fade-section opacity-0" style="background:var(--color-surface);">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="section-label mb-1">Featured</p>
          <h2 class="font-heading text-2xl md:text-3xl font-bold">Research & Experience</h2>
        </div>
        <a href="/research" class="text-sm font-medium hidden md:block" style="color:var(--color-accent);">
          All projects →
        </a>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {featuredProjects.map(p => (
          <a href={`/research/${p.slug}`} class="card block group overflow-hidden">
            {p.cover_image ? (
              <div class="w-full aspect-video overflow-hidden">
                <img src={p.cover_image} alt={p.title}
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
            ) : (
              <div class="w-full aspect-video flex items-center justify-center text-2xl"
                   style="background:var(--color-border);">
                {p.labels.includes('hardware') ? '🛰' : p.labels.includes('human-factors') ? '🏛' : '🔬'}
              </div>
            )}
            <div class="p-5">
              <h3 class="font-heading font-semibold text-sm leading-snug mb-2 group-hover:text-accent transition-colors"
                  style="color:var(--color-text-primary);">{p.title}</h3>
              <p class="text-xs leading-relaxed mb-3" style="color:var(--color-text-secondary);">
                {p.description.slice(0, 100)}…
              </p>
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono" style="color:var(--color-text-muted);">
                  {p.start}{p.end ? ` – ${p.end}` : ''}
                </span>
                <span class={`text-xs px-2 py-0.5 rounded-full ${p.status === 'active' ? 'bg-green-100 text-green-700' : ''}`}
                      style={p.status !== 'active' ? 'color:var(--color-text-muted)' : ''}>
                  {p.status === 'active' ? '● Active' : '✓ Done'}
                </span>
              </div>
              <!-- Labels at bottom -->
              <div class="flex flex-wrap gap-1 mt-3 pt-3 border-t" style="border-color:var(--color-border);">
                {p.labels.slice(0, 3).map((l: string) => (
                  <span class={`tag tag-${l} !text-xs`}>{l.replace('-', ' ')}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-6 text-center md:hidden">
        <a href="/research" class="text-sm font-medium" style="color:var(--color-accent);">All projects →</a>
      </div>
    </div>
  </section>

  <!-- ── RECENT PUBLICATIONS ────────────────────────────── -->
  <section class="fade-section opacity-0 max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="section-label mb-1">Selected</p>
        <h2 class="font-heading text-2xl md:text-3xl font-bold">Publications</h2>
      </div>
      <a href="/publications" class="text-sm font-medium hidden md:block" style="color:var(--color-accent);">
        All publications →
      </a>
    </div>
    <div class="space-y-3">
      {recentPubs.map(pub => (
        <div class="card p-5 flex gap-4 items-start">
          <div class="flex-1">
            <p class="text-sm font-medium leading-snug mb-1" style="color:var(--color-text-primary);">{pub.title}</p>
            <p class="text-xs mb-2" style="color:var(--color-text-secondary);">{pub.authors}</p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-mono" style="color:var(--color-text-muted);">
                <em>{pub.venue_short ?? pub.venue}</em>
                {pub.location ? `, ${pub.location}` : ''}{pub.month ? `, ${pub.month}` : ''} {pub.year}
              </span>
              <span class={`tag !text-xs ${pub.type === 'journal' ? 'tag-research' : 'tag-work'}`}>
                {pub.type === 'journal' ? 'Journal' : 'Conference'}
              </span>
              {pub.role === 'first' && <span class="tag tag-capstone !text-xs">First Author</span>}
              {pub.links?.poster && <a href={pub.links.poster} target="_blank" class="text-xs font-medium" style="color:var(--color-accent);">[Poster]</a>}
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-6 text-center md:hidden">
      <a href="/publications" class="text-sm font-medium" style="color:var(--color-accent);">All publications →</a>
    </div>
  </section>

</BaseLayout>

<!-- Scroll fade-in effect -->
<script>
  // Fade sections into view as they scroll into viewport
  const fadeSections = document.querySelectorAll<HTMLElement>('.fade-section');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('fade-in-active');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );

  fadeSections.forEach(el => observer.observe(el));

  // Hero parallax fade on scroll
  const hero = document.getElementById('hero');
  window.addEventListener('scroll', () => {
    if (!hero) return;
    const scrolled = window.scrollY;
    const heroH = hero.offsetHeight;
    const progress = Math.min(scrolled / heroH, 1);
    hero.style.opacity = String(1 - progress * 1.2);
  }, { passive: true });
</script>

<style is:global>
  .fade-section {
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .fade-section.fade-in-active {
    opacity: 1 !important;
    transform: translateY(0);
  }
</style>
