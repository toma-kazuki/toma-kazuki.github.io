---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECTS, PUBLICATIONS } from '../../data/mock';

export function getStaticPaths() {
  return PROJECTS.map(p => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;

// Look up related publications by ID
const relatedPubs = (project.related_publications ?? [])
  .map(id => PUBLICATIONS.find(p => p.id === id))
  .filter(Boolean);
---
<BaseLayout title={project.title}>
  <div class="max-w-4xl mx-auto px-6 py-12">
    <a href="/research" class="text-sm mb-6 inline-flex items-center gap-1 transition-colors"
       style="color:var(--color-text-muted);">
      ← Back to Research
    </a>

    <!-- Labels + Status -->
    <div class="flex flex-wrap gap-2 mb-4 mt-4">
      {project.labels.map((l: string) => (
        <span class={`tag tag-${l}`}>{l.replace(/-/g, ' ')}</span>
      ))}
      <span class={`text-xs px-2.5 py-0.5 rounded-full font-medium ${project.status === 'active' ? 'bg-green-100 text-green-700' : ''}`}
            style={project.status !== 'active' ? 'color:var(--color-text-muted);background:var(--color-surface);border:1px solid var(--color-border);' : ''}>
        {project.status === 'active' ? '● Active' : '✓ Completed'}
      </span>
    </div>

    <h1 class="font-heading text-3xl font-bold mb-4">{project.title}</h1>
    <p class="text-base mb-8 leading-relaxed max-w-prose" style="color:var(--color-text-secondary);">
      {project.description}
    </p>

    {project.cover_image && (
      <img src={project.cover_image} alt={project.title}
           class="w-full rounded-xl mb-10 aspect-video object-cover border"
           style="border-color:var(--color-border);" />
    )}

    <!-- Meta grid -->
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 mb-10 p-6 rounded-xl"
         style="background:var(--color-surface);border:1px solid var(--color-border);">
      <div>
        <p class="section-label mb-1">Period</p>
        <p class="text-sm font-mono">{project.start}{project.end ? ` – ${project.end}` : ' – Ongoing'}</p>
      </div>
      {project.advisor && (
        <div>
          <p class="section-label mb-1">Advisor</p>
          <p class="text-sm">{project.advisor}</p>
        </div>
      )}
      {project.institutions && project.institutions.length > 0 && (
        <div>
          <p class="section-label mb-1">Institutions</p>
          {project.institutions.map((i: string) => <p class="text-sm">{i}</p>)}
        </div>
      )}
      {project.funding && project.funding.length > 0 && (
        <div class="sm:col-span-2 md:col-span-3">
          <p class="section-label mb-1">Funding</p>
          <div class="flex flex-wrap gap-2">
            {project.funding.map((f: string) => (
              <span class="text-xs px-2.5 py-1 rounded-lg" style="background:var(--color-bg);border:1px solid var(--color-border);color:var(--color-text-secondary);">
                {f}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Project detail (placeholder for MDX content) -->
    <div class="mb-12 p-6 rounded-xl border-l-4" style="border-color:var(--color-accent);background:var(--color-surface);">
      <p class="text-sm font-medium mb-1" style="color:var(--color-accent);">Project Details</p>
      <p class="text-sm" style="color:var(--color-text-secondary);">
        Full narrative content will be authored in MDX format in the production build.
        This will include methodology, technical contributions, and key results.
      </p>
    </div>

    <!-- Related Publications -->
    {relatedPubs.length > 0 && (
      <div>
        <h2 class="font-heading text-xl font-semibold mb-5">Related Publications</h2>
        <div class="space-y-3">
          {relatedPubs.map(pub => pub && (
            <div class="card p-5">
              <!-- Type + role badges -->
              <div class="flex flex-wrap gap-2 mb-3">
                <span class={`tag !text-xs ${pub.type === 'journal' ? 'tag-research' : 'tag-work'}`}>
                  {pub.type === 'journal' ? 'Journal' : 'Conference'}
                </span>
                {pub.role === 'first' && (
                  <span class="tag tag-capstone !text-xs">First Author</span>
                )}
              </div>

              <!-- Title -->
              <p class="text-sm font-semibold leading-snug mb-2" style="color:var(--color-text-primary);">
                {pub.title}
              </p>

              <!-- Authors -->
              <p class="text-xs mb-2" style="color:var(--color-text-secondary);">{pub.authors}</p>

              <!-- Venue + links -->
              <div class="flex flex-wrap items-center gap-3">
                <p class="text-xs" style="color:var(--color-text-muted);">
                  <em>{pub.venue_short ?? pub.venue}</em>
                  {pub.location && `, ${pub.location}`}
                  {pub.month && `, ${pub.month}`} {pub.year}
                </p>
                {pub.links?.poster && (
                  <a href={pub.links.poster} target="_blank"
                     class="text-xs font-medium px-2.5 py-1 rounded-lg border transition-colors"
                     style="color:var(--color-accent);border-color:var(--color-accent);">[Poster]</a>
                )}
                {pub.links?.materials && (
                  <a href={pub.links.materials} target="_blank"
                     class="text-xs font-medium px-2.5 py-1 rounded-lg border transition-colors"
                     style="color:var(--color-accent);border-color:var(--color-accent);">[Materials]</a>
                )}
              </div>
            </div>
          ))}
        </div>
        <p class="mt-4 text-sm">
          <a href="/publications" style="color:var(--color-accent);">View all publications →</a>
        </p>
      </div>
    )}
  </div>
</BaseLayout>
