---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PUBLICATIONS } from '../data/mock';
const journals = PUBLICATIONS.filter(p => p.type === 'journal');
const firstAuthorConf = PUBLICATIONS.filter(p => p.type === 'conference' && p.role === 'first');
const coAuthorConf = PUBLICATIONS.filter(p => p.type === 'conference' && p.role === 'co');
---
<BaseLayout title="Publications">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <div class="mb-8">
      <p class="section-label mb-1">Academic Output</p>
      <h1 class="font-heading text-3xl font-bold">Publications</h1>
      <p class="text-sm mt-2" style="color:var(--color-text-secondary);">
        Also available on
        <a href="https://www.researchgate.net/profile/Kazuki-Toma" target="_blank" style="color:var(--color-accent);">ResearchGate</a>
        and <a href="#" target="_blank" style="color:var(--color-accent);">Google Scholar</a>.
      </p>
    </div>

    <!-- Filter bar -->
    <div class="sticky top-16 z-10 flex flex-wrap gap-2 py-3 -mx-6 px-6 mb-8 border-b"
         style="background:var(--color-bg);border-color:var(--color-border);">
      {[
        { id: 'all', label: 'All' },
        { id: 'journal', label: 'Journal' },
        { id: 'conference', label: 'Conference' },
        { id: 'first', label: 'First Author' },
        { id: 'co', label: 'Co-Author' },
      ].map(f => (
        <button class="pub-filter text-xs px-3 py-1.5 rounded-full border font-medium transition-all cursor-pointer"
                data-pub-filter={f.id}
                style="border-color:var(--color-border);color:var(--color-text-secondary);">
          {f.label}
        </button>
      ))}
    </div>

    <!-- Journal Papers -->
    <section class="mb-10">
      <h2 class="font-heading text-lg font-semibold mb-4 pb-2 border-b" style="border-color:var(--color-border);">
        Journal Papers
      </h2>
      <div class="space-y-3">
        {journals.map(pub => (
          <div class="card p-5 pub-item" data-type={pub.type} data-role={pub.role}>
            <p class="text-sm font-medium leading-snug mb-1" style="color:var(--color-text-primary);">{pub.title}</p>
            <p class="text-xs mb-1" style="color:var(--color-text-secondary);">{pub.authors}</p>
            <p class="text-xs italic mb-2" style="color:var(--color-text-muted);">
              {pub.venue}{pub.year ? `, ${pub.year}` : ''}
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="tag tag-research !text-xs">Journal</span>
              <span class="tag tag-capstone !text-xs">First Author</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Conference Papers: First Author -->
    <section class="mb-10">
      <h2 class="font-heading text-lg font-semibold mb-4 pb-2 border-b" style="border-color:var(--color-border);">
        Conference Papers — First Author
      </h2>
      <div class="space-y-3">
        {firstAuthorConf.map(pub => (
          <div class="card p-5 pub-item" data-type={pub.type} data-role={pub.role}>
            <p class="text-sm font-medium leading-snug mb-1" style="color:var(--color-text-primary);">{pub.title}</p>
            <p class="text-xs mb-1" style="color:var(--color-text-secondary);">{pub.authors}</p>
            <p class="text-xs mb-2" style="color:var(--color-text-muted);">
              <em>{pub.venue_short ?? pub.venue}</em>
              {pub.location && `, ${pub.location}`}
              {pub.month && `, ${pub.month}`} {pub.year}
            </p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="tag tag-work !text-xs">Conference</span>
              <span class="tag tag-capstone !text-xs">First Author</span>
              {pub.links?.poster && <a href={pub.links.poster} target="_blank" class="text-xs font-medium" style="color:var(--color-accent);">[Poster]</a>}
              {pub.links?.materials && <a href={pub.links.materials} target="_blank" class="text-xs font-medium" style="color:var(--color-accent);">[Materials]</a>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Conference Papers: Co-Author -->
    <section class="mb-10">
      <h2 class="font-heading text-lg font-semibold mb-4 pb-2 border-b" style="border-color:var(--color-border);">
        Conference Papers — Co-Author
      </h2>
      <div class="space-y-3">
        {coAuthorConf.map(pub => (
          <div class="card p-5 pub-item" data-type={pub.type} data-role={pub.role}>
            <p class="text-sm font-medium leading-snug mb-1" style="color:var(--color-text-primary);">{pub.title}</p>
            <p class="text-xs mb-1" style="color:var(--color-text-secondary);">{pub.authors}</p>
            <p class="text-xs mb-2" style="color:var(--color-text-muted);">
              <em>{pub.venue_short ?? pub.venue}</em>
              {pub.location && `, ${pub.location}`}
              {pub.month && `, ${pub.month}`} {pub.year}
            </p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="tag tag-work !text-xs">Conference</span>
              {pub.links?.materials && <a href={pub.links.materials} target="_blank" class="text-xs font-medium" style="color:var(--color-accent);">[Materials]</a>}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.pub-filter');
  const items = document.querySelectorAll<HTMLElement>('.pub-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.pubFilter!;
      filterBtns.forEach(b => {
        b.style.background = ''; b.style.borderColor = 'var(--color-border)'; b.style.color = 'var(--color-text-secondary)';
      });
      btn.style.background = 'var(--color-accent)';
      btn.style.borderColor = 'var(--color-accent)';
      btn.style.color = 'white';
      items.forEach(item => {
        const show = f === 'all'
          || (f === 'journal' && item.dataset.type === 'journal')
          || (f === 'conference' && item.dataset.type === 'conference')
          || (f === 'first' && item.dataset.role === 'first')
          || (f === 'co' && item.dataset.role === 'co');
        item.style.display = show ? '' : 'none';
      });
    });
  });

  // Default: All
  const allBtn = document.querySelector<HTMLButtonElement>('[data-pub-filter="all"]')!;
  allBtn.style.background = 'var(--color-accent)';
  allBtn.style.borderColor = 'var(--color-accent)';
  allBtn.style.color = 'white';
</script>
