---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Blog">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <p class="section-label mb-1">Writing</p>
    <h1 class="font-heading text-3xl font-bold mb-4">Blog</h1>
    <div class="rounded-lg border p-12 text-center" style="border-color:var(--color-border);background:var(--color-surface);">
      <p class="text-lg font-heading mb-2" style="color:var(--color-text-secondary);">Coming Soon</p>
      <p class="text-sm" style="color:var(--color-text-muted);">Technical notes and life log — powered by MDX.</p>
    </div>
  </div>
</BaseLayout>
