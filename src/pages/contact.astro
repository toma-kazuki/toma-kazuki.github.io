---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import ContactDetails from '../components/ContactDetails.astro';
import { PROFILE } from '../data/profile';
---
<BaseLayout title="Contact - Kazuki Toma" description="Contact Kazuki Toma - Ph.D. Student in Aerospace Engineering at Texas A&M University">
  <PageHead title="Contact" />

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="form-sent" data-form-sent role="status" hidden>Thanks, your message was sent.</p>
        <form class="contact-form" action={`https://formsubmit.co/${PROFILE.email}`} method="POST">
          <input type="hidden" name="_subject" value="[Website] Contact form">
          <input type="hidden" name="_next" value="https://toma-kazuki.github.io/contact/?sent=1">
          <input type="hidden" name="_captcha" value="false">
          <input class="honey" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true">
          <label>Name <input name="name" type="text" required autocomplete="name"></label>
          <label>Email <input name="email" type="email" required autocomplete="email"></label>
          <label>Phone (optional) <input name="phone" type="tel" autocomplete="tel"></label>
          <label>Message <textarea name="message" rows="6" required></textarea></label>
          <button class="submit" type="submit">Send message</button>
        </form>
      </div>
      <ContactDetails />
    </div>
  </section>

  <script is:inline>
    if (new URLSearchParams(location.search).get('sent') === '1') {
      document.querySelector('[data-form-sent]').hidden = false;
    }
  </script>
</BaseLayout>
